  "dynamics": {
    "tick_seconds": 30,
    "rules": [
      {
        "name": "ongoing_exposure_worsens_academy",
        "when": "flags.infusion_running and t >= 30",
        "effects": {
          "delta_symptoms": {
            "rash": 1,
            "wheeze": 1
          },
          "delta_vitals": {
            "SpO2": -3,
            "HR": 8,
            "SBP": -6,
            "RR": 2
          }
        }
      },
      {
        "name": "basic_support_stabilizes_academy",
        "when": "flags.stopped_infusion and flags.help_called and flags.oxygen_on and t >= 60 and (t % 60 == 0)",
        "effects": {
          "delta_symptoms": {
            "wheeze": -1
          },
          "delta_vitals": {
            "SpO2": 2,
            "HR": -3,
            "SBP": 2,
            "RR": -1
          }
        }
      },
      {
        "name": "unaddressed_risk_progresses_academy",
        "when": "(not flags.stopped_infusion or not flags.help_called) and t >= 180 and (t % 90 == 0)",
        "effects": {
          "delta_symptoms": {
            "wheeze": 1,
            "consciousness": 1
          },
          "delta_vitals": {
            "SpO2": -4,
            "HR": 10,
            "SBP": -8,
            "RR": 3
          }
        }
      }
    ]
  },
  "end_conditions": {
    "success_when": "flags.academy_completed and flags.academy_reassessment_done",
    "failure_when": "flags.dead or vitals.SpO2 <= 80 or vitals.SBP < age_sbp_threshold",
    "max_time_seconds": 900
  },
  "reporting": {
    "observe_recommendation": {
      "label": "教师预试运行提示",
      "text": "本版本为学院教师封闭式预试运行版，重点用于评估护生教学适配性、内容准确性、身份边界和系统可用性；不建议直接作为正式学生研究采集数据。"
    },
    "issue_profile": "academy_anaphylaxis_rescue"
  },
  "training": {
    "min_time_seconds_for_success": 0,
    "min_reassess_count_recommended": 1,
    "show_feedback_after_each_choice": true,
    "record_first_choice": true,
    "record_final_choice": true,
    "guided_prompts": [
      {
        "text": "步骤1：先判断当前异常情况是否提示严重过敏反应风险。",
        "reason": "护生教学重点是早期识别危险信号。",
        "done_when": "flags.allergy_identified"
      },
      {
        "text": "步骤2：暂停当前可疑输入，同时保留静脉通道。",
        "reason": "减少持续暴露，同时保证后续抢救用药和补液通道。",
        "done_when": "flags.stopped_infusion and flags.iv_access"
      },
      {
        "text": "步骤3：立即呼叫带教老师、上级护士和医生。",
        "reason": "护生不独立承担抢救决策，应快速进入团队协作。",
        "done_when": "flags.help_called"
      },
      {
        "text": "步骤4：在老师到达前后完成基础氧疗、监测和循环评估配合。",
        "reason": "严重过敏反应可累及气道、呼吸和循环。",
        "done_when": "flags.oxygen_on and flags.monitor_on and flags.bp_checked"
      },
      {
        "text": "步骤5：准备抢救车、肾上腺素、注射器、晶体液和氧疗物品，并配合核对。",
        "reason": "肾上腺素是一线急救药物，但护生应在老师/医生指导下配合核对，不独立给药。",
        "done_when": "flags.rescue_equipment_prepared"
      },
      {
        "text": "步骤6：初步处理后复评生命体征和症状变化。",
        "reason": "不能只关注皮疹，还要复评呼吸、循环、意识和血氧。",
        "done_when": "flags.academy_reassessment_done"
      },
      {
